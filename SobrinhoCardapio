<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sobrinho Lounge | Cardápio Digital</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;700;900&family=Inter:wght@300;400;600&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #050505;
            color: #e5e5e5;
        }
        .font-heading {
            font-family: 'Outfit', sans-serif;
        }
        .neon-gradient {
            background: linear-gradient(to right, #ec4899, #8b5cf6);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .menu-card {
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(236, 72, 153, 0.1);
            transition: all 0.3s ease;
        }
        .menu-card:hover {
            border-color: rgba(236, 72, 153, 0.5);
            box-shadow: 0 0 15px rgba(236, 72, 153, 0.1);
            transform: translateY(-2px);
        }
        .tab-active {
            border-bottom: 2px solid #ec4899;
            color: #ec4899;
            text-shadow: 0 0 10px rgba(236, 72, 153, 0.4);
        }
    </style>
</head>
<body class="min-h-screen pb-20">

    <!-- Header / Hero -->
    <header class="relative h-72 flex items-center justify-center overflow-hidden">
        <div class="absolute inset-0 bg-gradient-to-b from-black/40 via-black/70 to-[#050505] z-10"></div>
        <img src="https://images.unsplash.com/photo-1566737236500-c8ac43014a67?auto=format&fit=crop&q=80&w=1000" alt="Neon Lounge Background" class="absolute inset-0 w-full h-full object-cover">
        <div class="relative z-20 text-center px-4">
            <h1 class="text-5xl font-heading font-black neon-gradient mb-3 tracking-tight">SOBRINHO LOUNGE</h1>
            <p class="text-xs font-semibold tracking-[0.4em] uppercase text-fuchsia-400">Drinks • Hookah • Vibes</p>
        </div>
    </header>

    <!-- Navigation Tabs -->
    <nav class="sticky top-0 z-30 bg-[#0a0a0a]/90 backdrop-blur-md border-b border-white/10">
        <div class="flex justify-around items-center max-w-md mx-auto">
            <button onclick="showCategory('drinks')" id="tab-drinks" class="py-4 px-2 text-sm font-semibold uppercase tracking-wider tab-active transition-all">Drinks</button>
            <button onclick="showCategory('comidas')" id="tab-comidas" class="py-4 px-2 text-sm font-semibold uppercase tracking-wider text-gray-500 transition-all">Porções</button>
            <button onclick="showCategory('narguilé')" id="tab-narguilé" class="py-4 px-2 text-sm font-semibold uppercase tracking-wider text-gray-500 transition-all">Narguilé</button>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="max-w-2xl mx-auto px-4 mt-8">
        
        <!-- Categoria: Drinks -->
        <section id="cat-drinks" class="category-content">
            <h2 class="text-2xl font-heading font-bold uppercase tracking-wider mb-6 text-center neon-gradient">Coquetéis & Bebidas</h2>
            <div class="grid gap-4">
                <!-- Item -->
                <div class="menu-card p-4 rounded-xl flex justify-between items-center">
                    <div class="flex-1">
                        <h3 class="font-semibold text-white">Gin Tônica Premium</h3>
                        <p class="text-xs text-gray-400 leading-relaxed">Gin importado, tônica premium, especiarias e frutas cítricas.</p>
                    </div>
                    <div class="ml-4 font-bold text-pink-500">R$ --,--</div>
                </div>
                <!-- Item -->
                <div class="menu-card p-4 rounded-xl flex justify-between items-center">
                    <div class="flex-1">
                        <h3 class="font-semibold text-white">Moscow Mule</h3>
                        <p class="text-xs text-gray-400 leading-relaxed">Vodka, suco de limão, xarope de açúcar e espuma de gengibre artesanal.</p>
                    </div>
                    <div class="ml-4 font-bold text-pink-500">R$ --,--</div>
                </div>
                <!-- Item -->
                <div class="menu-card p-4 rounded-xl flex justify-between items-center">
                    <div class="flex-1">
                        <h3 class="font-semibold text-white">Caipirinha de Morango</h3>
                        <p class="text-xs text-gray-400 leading-relaxed">Cachaça artesanal ou Vodka, morangos frescos e açúcar orgânico.</p>
                    </div>
                    <div class="ml-4 font-bold text-pink-500">R$ --,--</div>
                </div>
            </div>
        </section>

        <!-- Categoria: Comidas (Hidden by default) -->
        <section id="cat-comidas" class="category-content hidden">
            <h2 class="text-2xl font-heading font-bold uppercase tracking-wider mb-6 text-center neon-gradient">Petiscos & Porções</h2>
            <div class="grid gap-4">
                <div class="menu-card p-4 rounded-xl flex justify-between items-center">
                    <div class="flex-1">
                        <h3 class="font-semibold text-white">Batata Rústica Sobrinho</h3>
                        <p class="text-xs text-gray-400 leading-relaxed">Com alecrim, sal grosso e acompanhada de maionese da casa.</p>
                    </div>
                    <div class="ml-4 font-bold text-pink-500">R$ --,--</div>
                </div>
                <div class="menu-card p-4 rounded-xl flex justify-between items-center">
                    <div class="flex-1">
                        <h3 class="font-semibold text-white">Mix de Mini Pastéis</h3>
                        <p class="text-xs text-gray-400 leading-relaxed">10 unidades: Carne, Queijo e Palmito.</p>
                    </div>
                    <div class="ml-4 font-bold text-pink-500">R$ --,--</div>
                </div>
            </div>
        </section>

        <!-- Categoria: Narguilé (Hidden by default) -->
        <section id="cat-narguilé" class="category-content hidden">
            <h2 class="text-2xl font-heading font-bold uppercase tracking-wider mb-6 text-center neon-gradient">Sessão de Narguilé</h2>
            <div class="grid gap-4">
                <div class="menu-card p-4 rounded-xl flex justify-between items-center">
                    <div class="flex-1">
                        <h3 class="font-semibold text-white">Sessão Premium</h3>
                        <p class="text-xs text-gray-400 leading-relaxed">Escolha sua essência premium (Zomo, Nay, Tangiers).</p>
                    </div>
                    <div class="ml-4 font-bold text-pink-500">R$ --,--</div>
                </div>
                <div class="menu-card p-4 rounded-xl flex justify-between items-center">
                    <div class="flex-1">
                        <h3 class="font-semibold text-white">Aluguel de Rosh Extra</h3>
                        <p class="text-xs text-gray-400 leading-relaxed">Reposição de essência e carvão.</p>
                    </div>
                    <div class="ml-4 font-bold text-pink-500">R$ --,--</div>
                </div>
            </div>
        </section>

    </main>

    <!-- Footer / Infos -->
    <footer class="mt-12 px-6 text-center border-t border-white/5 pt-8 pb-12 bg-black/60 backdrop-blur-sm">
        <div class="mb-6">
            <p class="text-sm text-pink-500 font-bold uppercase tracking-wider mb-2">📍 Localização</p>
            <p class="text-xs text-gray-400">Rua Exemplo, 123 - Centro<br>São Paulo, SP</p>
        </div>
        <div class="mb-6">
            <p class="text-sm text-pink-500 font-bold uppercase tracking-wider mb-2">📱 Redes Sociais</p>
            <div class="flex justify-center space-x-6">
                <a href="https://www.instagram.com/sobrinholounge/" target="_blank" class="text-gray-400 hover:text-pink-500 transition-colors">Instagram</a>
                <a href="#" class="text-gray-400 hover:text-purple-500 transition-colors">WhatsApp</a>
            </div>
        </div>
        <p class="text-[10px] text-gray-600 uppercase tracking-widest">© 2024 Sobrinho Lounge</p>
    </footer>

    <!-- Scripts de Navegação -->
    <script>
        function showCategory(category) {
            // Esconder todas as seções
            document.querySelectorAll('.category-content').forEach(section => {
                section.classList.add('hidden');
            });

            // Remover estilo ativo de todos os botões
            document.querySelectorAll('nav button').forEach(btn => {
                btn.classList.remove('tab-active');
                btn.classList.add('text-gray-500');
            });

            // Mostrar a seção selecionada
            document.getElementById('cat-' + category).classList.remove('hidden');

            // Adicionar estilo ativo no botão clicado
            document.getElementById('tab-' + category).classList.add('tab-active');
            document.getElementById('tab-' + category).classList.remove('text-gray-500');

            // Scroll suave para o topo do conteúdo
            window.scrollTo({ top: 200, behavior: 'smooth' });
        }
    </script>

</body>
</html>
